{
  "name": "openclaw-admin-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=cjs --external:@aws-sdk/*",
    "dev": "tsx dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1033.0",
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/client-ecs": "^3.800.0",
    "@aws-sdk/client-secrets-manager": "^3.800.0",
    "@aws-sdk/lib-dynamodb": "^3.800.0",
    "@fastify/aws-lambda": "^5.1.0",
    "aws-jwt-verify": "^4.0.1",
    "fastify": "^5.3.3",
    "jose": "^6.2.2",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fast-check": "^4.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.4"
  }
}
